# ===========================================================================

# KompasOS — mühit konfiqurasiyası NÜMUNƏSİ

# ===========================================================================

# Bu faylı `.env` adı ilə kopyalayın və real dəyərləri doldurun.

# `.env` faylı `.gitignore`-dadır və HEÇ VAXT repozitoriyaya commit edilmir.

#

# İSTEHSALATDA (production) bu dəyərlər .env faylından DEYİL:

#   * CI/CD-də → GitHub Secrets

#   * Mağaza PC-lərində → Windows DPAPI credential store

# vasitəsilə təchiz olunur (bax spesifikasiya bölmə 2).

# ===========================================================================



# --- Mühit ------------------------------------------------------------------

# DEV | STAGING | PRODUCTION

# DEV rejimində schema.sql seed tenant-i "Aktiv" statusda yaradır ki,

# LICENSE_INACTIVE bloku erkən fazalarda testləri dayandırmasın.

KOMPASOS_ENV=DEV

# Log qovluğu. BOŞ BURAXILA BİLƏR — defolt `%PROGRAMDATA%\KompasOS\logs`
# (Linux/macOS: `~/.local/share/KompasOS/logs`). `./logs` QƏSDƏN DEFOLT
# DEYİL: Setup ilə quraşdırılan `.exe` qısayoldan açılanda cari qovluq
# `C:\Windows\System32` olur və ora yazıla bilmir — ilk log sətri itərdi.
KOMPASOS_LOG_DIR=

KOMPASOS_LOG_LEVEL=INFO

# Əsas sapın DONMA həddi, millisaniyə. BOŞ BURAXILA BİLƏR — defolt 1000.
# Bu qədər gecikən hər kilidlənmə `MAIN_THREAD_STALL` kimi `app.log`-a düşür.
# Sistem limiti (`system_limits`) DEYİL: monitor açılış yolunda, baza hələ
# açılmamış işə düşür — dəyəri bazadan oxusaydı, ən çox donan yerdə susardı.
# Səhv yazılmış dəyər tətbiqi DAYANDIRMIR, defolta qayıdır.
KOMPASOS_STALL_WARN_MS=



# --- Şifrələmə: AES-256-GCM master açarı (KRİTİK, bax SEC-002) --------------

# Yeni açar yaratmaq:

#   python -c "from src.infrastructure.security.encryption import generate_key; print(generate_key())"

# QEYD: dəyişənin adı geriyə uyğunluq üçün "FERNET" olaraq qalıb; faktiki

# alqoritm AES-256-GCM-dir, köhnə Fernet token-ləri isə oxunmağa davam edir.

KOMPASOS_FERNET_KEY=

# Rotasiyadan sonra köhnə açarlar (vergüllə ayrılmış) — köhnə məlumat oxunsun deyə.

KOMPASOS_FERNET_KEY_PREVIOUS=

# Windows DPAPI blobunun yolu. BOŞ BURAXILA BİLƏR — defolt açarın ƏHATƏSİNDƏN
# asılıdır: istifadəçi əhatəli açar `%LOCALAPPDATA%\KompasOS\kompasos.key`,
# MAŞIN əhatəli açar (bağlantı parolu) isə `%PROGRAMDATA%\KompasOS\kompasos.key`.
# Səbəb: paylaşılan `connection.json`-u ikinci Windows hesabı da AÇA BİLMƏLİDİR.
# Köhnə quraşdırmada blob `%LOCALAPPDATA%`-da qalıbsa o işlədilməyə davam edir.

KOMPASOS_DPAPI_KEY_PATH=



# --- Hash pepper: 4-RƏQƏMLİ PIN ÜÇÜN MƏCBURİ (KRİTİK, bax SEC-005) ----------

# 4-rəqəmli PIN-in cəmi 10 000 variantı var. Bu dəyər OLMADAN, baza sızarsa

# bütün PIN-lər dəqiqələr içində brute-force ilə bərpa oluna bilər.

# Pepper BAZADA saxlanılmır — məhz bu, onun bütün mənasıdır.

#   python -c "from src.infrastructure.security.hashing import generate_pepper; print(generate_pepper())"

KOMPASOS_HASH_PEPPER=

# ROTASİYA (lazy migration): köhnə pepper-ləri bura köçürün — ƏN YENİSİ ƏVVƏLDƏ.

# Köhnə hash-lər köhnə pepper ilə yoxlanılır və uğurlu girişdən SONRA

# avtomatik yeni pepper ilə yenidən yazılır (`employees.pepper_version`).

# Kütləvi PIN/şifrə sıfırlaması LAZIM DEYİL.

KOMPASOS_HASH_PEPPER_PREVIOUS=



# --- Supabase / PostgreSQL --------------------------------------------------

# BURADA ƏVVƏL `SUPABASE_URL`, `SUPABASE_ANON_KEY` və

# `SUPABASE_SERVICE_ROLE_KEY` adlı üç açar vardı — GERİ ƏLAVƏ ETMƏYİN.

#

# Onları HEÇ BİR KOD OXUMURDU: tətbiq həmişə `KOMPASOS_` prefiksli adlarla

# işləyir (`KOMPASOS_SUPABASE_URL`, `KOMPASOS_SUPABASE_ANON_KEY`,

# `KOMPASOS_SUPABASE_SERVICE_ROLE_KEY` — aşağıda, «Developer Paneli» və

# «Avtomatik yenilənmə» bölmələrində).

#

# Nəticə sükutlu və çaşdırıcı idi: quraşdıran adam `SUPABASE_SERVICE_ROLE_KEY`

# sətrini doldurur, Developer Paneli isə YENƏ açılmırdı — çünki panel tamamilə

# BAŞQA dəyişənə baxır və səbəb heç bir jurnalda görünmürdü.

DATABASE_URL=postgresql://user:password@host:5432/kompasos

# BU DƏYİŞƏN PAKETLƏNMİŞ QURAŞDIRMADA ADƏTƏN BOŞ OLUR (DB-4).
# Tətbiq `.env` faylını OXUMUR — Start menyusundan açılan `.exe`-də mühit
# dəyişəni yoxdur. Ona görə DSN ikinci mənbədən gəlir:
#     %PROGRAMDATA%\KompasOS\connection.json
# Sıra: `DATABASE_URL` → konfiqurasiya faylı → «Bağlantı Ayarları» ekranı.
# Faylda YALNIZ parol şifrələnir (AES-256-GCM, DPAPI maşın əhatəsi); host,
# port, baza və istifadəçi açıq qalır ki, quraşdırıcı onu gözlə yoxlaya bilsin.
#
# Faylın yolunu dəyişmək üçün (test/xüsusi quraşdırma):
KOMPASOS_CONNECTION_FILE=

# --- Cihaz kimliyi (DEVICE-1) -----------------------------------------------
# BOŞ BURAXILA BİLƏR — defolt `%PROGRAMDATA%\KompasOS\device.json`.
#
# Faylda YALNIZ `device_id` UUID-i var və o, ŞİFRƏLƏNMİR: sirr deyil.
# Cihaz təsdiqlənməyibsə UUID heç nə açmır; təsdiqlənibsə onu başqa maşına
# köçürmək aparat izi uyğunsuzluğu yaradır və audit-ə düşür.
#
# `connection.json`-dan AYRI fayldır və bu, qəsdəndir: bağlantı parolunu
# düzəltmək üçün faylı silmək cihazın təsdiqini də silərdi və mağaza yenidən
# admin təsdiqi gözləyərdi.
#
# Faylı SİLSƏNİZ cihaz YENİ qeydiyyat yaradır və köhnəsi lisenziya sayğacında
# passivlik həddi keçənə qədər yer tutmağa davam edir.
KOMPASOS_DEVICE_FILE=



# --- Lokal offline buffer ---------------------------------------------------

# BOŞ BURAXILA BİLƏR — defolt `%PROGRAMDATA%\KompasOS\data\offline_buffer.db`

# (Linux/macOS: `$XDG_DATA_HOME/KompasOS/data/...`, o da yoxdursa

# `~/.local/share/KompasOS/data/...`). Baza keçidi panelindəki

# "sinxronlaşmamış yazı" sayğacı məhz bu faylı oxuyur.

#

# NİYƏ DEFOLT ARTIQ `./data/...` DEYİL: cari iş qovluğu paketlənmiş `.exe`-də

# ixtiyaridir — Start menyusundan `C:\Windows\System32`, kiosk nəzarətçisindən

# isə `C:\Program Files\KompasOS`. Hər ikisi standart istifadəçi üçün yazıla

# bilmir və ilk offline yazı `unable to open database file` ilə çökürdü.

# Şablondakı dəyər də QƏSDƏN boşdur: doldurulmuş nümunə `.env`-ə kopyalananda

# həmin CWD-yə bağlı yolu geri qaytarardı (bax `src/shared/data_paths.py`).

#

# KÖHNƏ QURAŞDIRMA: `./data/offline_buffer.db` faylı hələ mövcuddursa proqram

# ONU işlətməyə davam edir — heç nə köçürülmür, göndərilməmiş yazı itmir.

KOMPASOS_SQLITE_PATH=



# --- Baza keçidi: ŞƏXSİ SERVER hədəfi (bax bölmə 2, `db_switch.py`) ---------

# «İnfrastruktur Və Baza Ayarları» panelindəki Bulud ↔ Şəxsi server keçidinin

# İKİNCİ hədəfi. BOŞ BURAXILA BİLƏR: müştərilərin əksəriyyəti yalnız buludda

# işləyir və o halda keçid cəhdi ekranda aydın səbəblə rədd edilir («Şəxsi

# server bağlantısı konfiqurasiya edilməyib»), tətbiq isə normal işləyir.

KOMPASOS_PRIVATE_SERVER_DSN=



# --- Plugin etibar reyestri (bax bölmə 1 SANDBOX QAYDASI) -------------------

# Format: `Naşir adı:ed25519_açıq_açar_hex,İkinci Naşir:...`

# BOŞ BURAXILA BİLƏR və bu, FAIL-CLOSED deməkdir: reyestr boşdursa HEÇ BİR

# plugin quraşdırıla bilmir (mövcud plugin siyahısı yenə görünür). Boş dəyəri

# "hər şeyə icazə var" kimi oxumaq plugin-in host prosesinə kod əlavə etdiyi

# nəzərə alınsa, ən təhlükəli səhv olardı.

KOMPASOS_PLUGIN_TRUSTED_PUBLISHERS=

#

# Plugin alt-prosesini açan Python interpretatorunun yolu.

# BOŞ BURAXILA BİLƏR — mənbədən icrada cari interpretator işlədilir, paketdə

# isə əvvəlcə `.exe`-nin yanındakı `python\python.exe`, sonra sistem PATH-ı

# yoxlanılır. Paketlənmiş maşında heç biri yoxdursa plugin-lər icra OLUNMUR və

# ekranda səbəb göstərilir; tətbiqin qalan hissəsi normal işləyir.

# NİYƏ AYRICA AÇAR: paketlənmiş `.exe` Python DEYİL — onu interpretator kimi

# çağırmaq `argparse` xətası verir və ya tətbiqin ikinci nüsxəsini açır

# (bax `src/shared/runtime.py: plugin_interpreter`).

KOMPASOS_PLUGIN_PYTHON=



# --- Cərimə sübut şəkilləri: Google Drive (bax migrations/002) --------------

# NİYƏ SUPABASE STORAGE DEYİL: sübut şəkilləri megabaytlarla yer tutur və

# Supabase-in pulsuz/aşağı planlarında saxlama kvotası tez dolur; müştərinin

# ÖZ Drive hesabı isə onun öz kvotasıdır. Bax `migrations/002` başlığı.

#

# Bunlar TENANT-a deyil, TƏTBİQƏ aiddir: bir Google Cloud layihəsi, hər tenant

# "Drive Bağlantısı" ekranından öz hesabı ilə razılıq verir. BOŞ BURAXILA

# BİLƏR — o halda cərimələr yenə normal yaranır, şəkillər isə lokal növbədə

# gözləyir və bağlantı qurulan kimi avtomatik yüklənir (`EvidenceUploadQueue`).

#

# Google Cloud Console-da OAuth klientinin tipi "Desktop app" OLMALIDIR:

# razılıq axını `http://127.0.0.1:<port>` üzərinə yönləndirir (bax

# `storage/oauth_flow.py` — köhnə "kodu kopyala" üsulu Google tərəfindən

# 2022-də qapadılıb). Port hər dəfə OS tərəfindən seçilir, ona görə Console-da

# konkret port qeydiyyatdan KEÇİRİLMİR — "Desktop app" tipi bütün loopback

# portlarına icazə verir.

KOMPASOS_GOOGLE_CLIENT_ID=

KOMPASOS_GOOGLE_CLIENT_SECRET=

# Yüklənməni gözləyən şəkillərin lokal indeksi.

# BOŞ BURAXILA BİLƏR — defolt `%PROGRAMDATA%\KompasOS\data\evidence_uploads.db`

# (Linux/macOS: `~/.local/share/KompasOS/data/...`). Səbəb `KOMPASOS_SQLITE_PATH`

# ilə eynidir: paketlənmiş `.exe`-nin cari qovluğu yazıla bilmir və ilk sübut

# şəkli itərdi. Şəkillərin BAYTLARI bu faylın yanındakı `evidence_spool/`

# qovluğunda saxlanılır, ona görə yolu dəyişəndə ikisi birlikdə köçürülməlidir.

# KÖHNƏ QURAŞDIRMA: `./data/evidence_uploads.db` mövcuddursa o işlədilir —

# yüklənməmiş şəkillər növbədə qalır (bax `src/shared/data_paths.py`).

KOMPASOS_EVIDENCE_QUEUE_PATH=



# --- NTP (saat sinxronizasiyası, bax bölmə 2) -------------------------------

# BU İKİ AÇAR SİLİNDİ — GERİ ƏLAVƏ ETMƏYİN.

#

# `KOMPASOS_NTP_SERVER` və `KOMPASOS_NTP_MAX_DRIFT_SECONDS` heç vaxt

# oxunmurdu: server siyahısı `timekeeping/ntp.py::DEFAULT_SERVERS`-dədir,

# sürüşmə həddi isə ROOT parametridir (`NTP_MAX_DRIFT_SECONDS`,

# `system_limits`, seed: migrations/032). Yəni burada yazılan dəyər

# HEÇ NƏYƏ təsir etmirdi — istifadəçi həddi dəyişdiyini sanardı.

#

# Həddi dəyişmək üçün ROOT panelindəki «Sistem limitləri» bölməsi işlədilir.



# --- Lisenziya (bax bölmə 8) ------------------------------------------------

# AYRICA LİSENZİYA SERVERİ YOXDUR: lisenziya qeydi mövcud Supabase

# layihəsindəki `license_tenants` cədvəlindədir. Müştəri tətbiqi öz sətrini

# YALNIZ OXUYUR (anon açar + RLS); yazma hüququ yoxdur.

#

# BOŞ BURAXILA BİLƏR (SEC-021). Boş dəyər «hələ quraşdırılmayıb» deməkdir:

# tətbiq bu maşın üçün yerli identifikator yaradır (`installation.json`),

# İlk Quraşdırma Sihirbazını açır və `license_tenants` sətrini ÖZÜ qurur —

# özünə-host edilən quraşdırma. Təchizatçıdan identifikator alındıqda buraya

# yazılır və növbəti açılışda O qalib gəlir; köhnə yerli identifikator faylda

# saxlanılır, çünki onunla yazılmış sətirlər avtomatik KÖÇMÜR.

KOMPASOS_TENANT_ID=

# Quraşdırma kimliyinin faylı. BOŞ OLA BİLƏR — defolt

# `%PROGRAMDATA%\KompasOS\data\installation.json` (CWD-yə nisbi YOX, səbəb

# `KOMPASOS_SQLITE_PATH` yanındakı ilə eynidir). Fayl silinsə və mühit

# dəyişəni də boş olsa, tətbiq YENİ quraşdırma sayılır və köhnə məlumat

# görünməz qalır — ehtiyat nüsxəyə bu fayl da daxil edilməlidir.

KOMPASOS_INSTALLATION_PATH=

# Bloklama ekranında göstərilən TƏCHİZATÇI əlaqəsi (müştərinin öz ünvanı deyil)

KOMPASOS_VENDOR_CONTACT=destek@example.com



# --- Vendor (mərkəzi) bazası — YALNIZ TƏCHİZATÇININ MAŞINI (DB-3) ----------
# Müştəri bazasından TAM AYRI baza. Müştəri quraşdırmasında bu dəyişən
# HEÇ VAXT olmur — `.exe` ona nə yazır, nə də oxuyur (paralel rejim qərarı).
#
# BOŞ OLA BİLƏR ✅ — yalnız `scripts/create_vendor_account.py` və vendor
# konsolu üçün lazımdır; tətbiqin işə düşməsinə TƏSİR ETMİR.
#
# BAĞLANTI ROLU: `BYPASSRLS` olmayan, `kompasos_vendor` üzvü bir rol olmalıdır.
# `service_role`/`postgres` bütün RLS siyasətlərini yan keçir — onlarla
# qoşulmaq serverdəki qorumanı mənasızlaşdırır
# (bax `database/migrations/vendor/002_vendor_rls.sql`).
KOMPASOS_VENDOR_DSN=

# --- Developer Paneli — YALNIZ HAZIRLAYICININ ÖZ KOMPÜTERİNDƏ ---------------

# DİQQƏT: `service_role` açarı TAM oxuma/yazma hüququ verir və RLS-i yan

# keçir. HEÇ VAXT müştəriyə göndərilən `.exe`-yə daxil edilmir, yalnız burada

# — `.gitignore`-dakı yerli `.env` faylında — saxlanılır.

# Panel internetə host OLUNMUR; `python -m src.main --developer-mode` ilə açılır.

KOMPASOS_DEVELOPER_MODE=

KOMPASOS_SUPABASE_SERVICE_ROLE_KEY=



# --- Avtomatik yenilənmə (bax bölmə 1, 7) -----------------------------------

# AYRICA UPDATE SERVERİ/CDN YOXDUR: buraxılış kataloqu `app_versions`

# cədvəlidir, quraşdırıcı faylın özü isə `app-updates` (PRIVATE) bucket-indədir:

#   app-updates/{versiya}/KompasOS-Setup.exe

# Bucket private olduğu üçün endirmə `anon` açarı tələb edir — public link

# işləmir. Yükləmə isə YALNIZ `service_role` ilə (Developer Paneli).

KOMPASOS_SUPABASE_URL=

KOMPASOS_SUPABASE_ANON_KEY=

KOMPASOS_UPDATE_BUCKET=app-updates

# Authenticode naşir yoxlaması — BOŞ BURAXMAYIN: bu olmadan İSTƏNİLƏN etibarlı

# imza qəbul edilir (hücumçunun öz qanuni sertifikatı da daxil).

KOMPASOS_UPDATE_PUBLISHER=O=Kompas MMC



# --- Gecəlik ehtiyat nüsxə (bax bölmə 7) ------------------------------------

# `pg_dump` PATH-də olmalıdır. Saxlama müddəti kodda minimum 30 gündür.

KOMPASOS_BACKUP_DIR=



# --- E-poçt fallback (bax bölmə 7) ------------------------------------------

KOMPASOS_SMTP_HOST=

KOMPASOS_SMTP_PORT=587

KOMPASOS_SMTP_USER=

KOMPASOS_SMTP_PASSWORD=

KOMPASOS_SMTP_FROM=noreply@example.com

# Tətbiq açılmasa belə müştərinin çata biləcəyi statik ünvan (bölmə 8)

KOMPASOS_SUPPORT_EMAIL=destek@example.com



# --- Face Control — kiosk kamerası (`facecontrol.md` Faza 3) ----------------

# BOŞ OLA BİLƏR: boş buraxılarsa sistemdəki BİRİNCİ kamera (indeks 0)

# işlədilir — tək kameralı kiosk PC-lərində gözlənilən vəziyyət budur.

# Doldurmaq YALNIZ o zaman lazımdır ki, maşında bir neçə kamera olsun (məs.

# noutbukun daxili kamerası + kioska bağlanmış USB kamera) və düzgün cihaz

# birinci olmasın. Yanlış indeks avadanlıq nasazlığı kimi emal olunur:

# üz təsdiqi SÜKUTLA keçilmir, təsdiq HR_Admin/CEO-ya eskalasiya edilir.

KOMPASOS_CAMERA_INDEX=



# --- Kiosk PIN handshake filialı (dövrə 2 audit, INF2-04) -------------------

# BOŞ BURAXILA BİLMƏZ (kiosk rejimində): `_build_kiosk_controller()`

# (`src/presentation/app.py`) bu dəyər boşdursa kiosk PIN kontrollerini

# ÜMUMİYYƏTLƏ QURMUR — PIN handshake HEÇ İŞƏ DÜŞMÜR. Hər kiosk PC-si BİR

# mağazaya bağlıdır: PIN axtarışı YALNIZ həmin mağazanın işçiləri arasında

# aparılır, "bütün mağazalarda axtar" seçimi həm performans (yüzlərlə işçi

# üçün Argon2 hesablaması), həm təhlükəsizlik baxımından (başqa filialın

# işçisi bu terminalda giriş edə bilməz) rədd edilib.

KOMPASOS_STORE_ID=



# --- Sübut şəkli keşinin qovluğu (dövrə 2 audit, INF2-04) -------------------

# BOŞ BURAXILA BİLƏR — defolt `%APPDATA%\KompasOS\image_cache\`

# (Linux/macOS: `$XDG_CACHE_HOME/KompasOS/image_cache`, o da yoxdursa

# `~/.cache/KompasOS/image_cache`). Kamera Dashboard-un göstərdiyi sübut

# şəkilləri buraya keşlənir (`IMAGE_CACHE_TTL_SECONDS`/`IMAGE_CACHE_MAX_BYTES`

# ilə idarə olunur, Root parametridir) — boş qalarsa şəkillər sadəcə hər

# dəfə Drive-dan YENİDƏN endirilir, funksionallıq itmir.

KOMPASOS_IMAGE_CACHE_DIR=



# --- Lisenziya vəziyyət faylının qovluğu (dövrə 2 audit, INF2-04) -----------

# BOŞ BURAXILA BİLƏR — defolt `%APPDATA%\KompasOS\` (Linux/macOS:

# `$XDG_STATE_HOME/KompasOS`, o da yoxdursa `~/.local/state/KompasOS`).

# `license_state.bin` (şifrələnmiş) burada saxlanılır — lisenziya

# yoxlamasının son bilinən nəticəsi, offline dövrlərdə istifadə üçün.

KOMPASOS_STATE_DIR=

