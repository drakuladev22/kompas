# ===========================================================================
# KompasOS — mühit konfiqurasiyası NÜMUNƏSİ
# ===========================================================================
# Bu faylı `.env` adı ilə kopyalayın və real dəyərləri doldurun.
# `.env` faylı `.gitignore`-dadır və HEÇ VAXT repozitoriyaya commit edilmir.
#
# İSTEHSALATDA (production) bu dəyərlər .env faylından DEYİL:
#   * CI/CD-də → GitHub Secrets
#   * Mağaza PC-lərində → Windows DPAPI credential store
# vasitəsilə təchiz olunur (bax spesifikasiya bölmə 2).
# ===========================================================================

# --- Mühit ------------------------------------------------------------------
# DEV | STAGING | PRODUCTION
# DEV rejimində schema.sql seed tenant-i "Aktiv" statusda yaradır ki,
# LICENSE_INACTIVE bloku erkən fazalarda testləri dayandırmasın.
KOMPASOS_ENV=DEV
KOMPASOS_LOG_DIR=./logs
KOMPASOS_LOG_LEVEL=INFO

# --- Şifrələmə: AES-256-GCM master açarı (KRİTİK, bax SEC-002) --------------
# Yeni açar yaratmaq:
#   python -c "from src.infrastructure.security.encryption import generate_key; print(generate_key())"
# QEYD: dəyişənin adı geriyə uyğunluq üçün "FERNET" olaraq qalıb; faktiki
# alqoritm AES-256-GCM-dir, köhnə Fernet token-ləri isə oxunmağa davam edir.
KOMPASOS_FERNET_KEY=
# Rotasiyadan sonra köhnə açarlar (vergüllə ayrılmış) — köhnə məlumat oxunsun deyə.
KOMPASOS_FERNET_KEY_PREVIOUS=
# Windows DPAPI blobunun yolu (boş buraxılsa: %LOCALAPPDATA%\KompasOS\kompasos.key)
KOMPASOS_DPAPI_KEY_PATH=

# --- Hash pepper: 4-RƏQƏMLİ PIN ÜÇÜN MƏCBURİ (KRİTİK, bax SEC-005) ----------
# 4-rəqəmli PIN-in cəmi 10 000 variantı var. Bu dəyər OLMADAN, baza sızarsa
# bütün PIN-lər dəqiqələr içində brute-force ilə bərpa oluna bilər.
# Pepper BAZADA saxlanılmır — məhz bu, onun bütün mənasıdır.
#   python -c "from src.infrastructure.security.hashing import generate_pepper; print(generate_pepper())"
KOMPASOS_HASH_PEPPER=
# ROTASİYA (lazy migration): köhnə pepper-ləri bura köçürün — ƏN YENİSİ ƏVVƏLDƏ.
# Köhnə hash-lər köhnə pepper ilə yoxlanılır və uğurlu girişdən SONRA
# avtomatik yeni pepper ilə yenidən yazılır (`employees.pepper_version`).
# Kütləvi PIN/şifrə sıfırlaması LAZIM DEYİL.
KOMPASOS_HASH_PEPPER_PREVIOUS=

# --- Supabase / PostgreSQL --------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://user:password@host:5432/kompasos

# --- Lokal offline buffer ---------------------------------------------------
KOMPASOS_SQLITE_PATH=./data/offline_buffer.db

# --- Cərimə sübut şəkilləri: Google Drive (bax migrations/002) --------------
# NİYƏ SUPABASE STORAGE DEYİL: sübut şəkilləri megabaytlarla yer tutur və
# Supabase-in pulsuz/aşağı planlarında saxlama kvotası tez dolur; müştərinin
# ÖZ Drive hesabı isə onun öz kvotasıdır. Bax `migrations/002` başlığı.
#
# Bunlar TENANT-a deyil, TƏTBİQƏ aiddir: bir Google Cloud layihəsi, hər tenant
# "Drive Bağlantısı" ekranından öz hesabı ilə razılıq verir. BOŞ BURAXILA
# BİLƏR — o halda cərimələr yenə normal yaranır, şəkillər isə lokal növbədə
# gözləyir və bağlantı qurulan kimi avtomatik yüklənir (`EvidenceUploadQueue`).
#
# Google Cloud Console-da OAuth klientinin tipi "Desktop app" OLMALIDIR:
# razılıq axını `http://127.0.0.1:<port>` üzərinə yönləndirir (bax
# `storage/oauth_flow.py` — köhnə "kodu kopyala" üsulu Google tərəfindən
# 2022-də qapadılıb). Port hər dəfə OS tərəfindən seçilir, ona görə Console-da
# konkret port qeydiyyatdan KEÇİRİLMİR — "Desktop app" tipi bütün loopback
# portlarına icazə verir.
KOMPASOS_GOOGLE_CLIENT_ID=
KOMPASOS_GOOGLE_CLIENT_SECRET=
# Yüklənməni gözləyən şəkillərin lokal indeksi (boş: ./data/evidence_uploads.db)
KOMPASOS_EVIDENCE_QUEUE_PATH=

# --- NTP (saat sinxronizasiyası, bax bölmə 2) -------------------------------
KOMPASOS_NTP_SERVER=pool.ntp.org
KOMPASOS_NTP_MAX_DRIFT_SECONDS=60

# --- Lisenziya (bax bölmə 8) ------------------------------------------------
# AYRICA LİSENZİYA SERVERİ YOXDUR: lisenziya qeydi mövcud Supabase
# layihəsindəki `license_tenants` cədvəlindədir. Müştəri tətbiqi öz sətrini
# YALNIZ OXUYUR (anon açar + RLS); yazma hüququ yoxdur.
KOMPASOS_TENANT_ID=
# Bloklama ekranında göstərilən TƏCHİZATÇI əlaqəsi (müştərinin öz ünvanı deyil)
KOMPASOS_VENDOR_CONTACT=destek@example.com

# --- Developer Paneli — YALNIZ HAZIRLAYICININ ÖZ KOMPÜTERİNDƏ ---------------
# DİQQƏT: `service_role` açarı TAM oxuma/yazma hüququ verir və RLS-i yan
# keçir. HEÇ VAXT müştəriyə göndərilən `.exe`-yə daxil edilmir, yalnız burada
# — `.gitignore`-dakı yerli `.env` faylında — saxlanılır.
# Panel internetə host OLUNMUR; `python -m src.main --developer-mode` ilə açılır.
KOMPASOS_DEVELOPER_MODE=
KOMPASOS_SUPABASE_SERVICE_ROLE_KEY=

# --- Avtomatik yenilənmə (bax bölmə 1, 7) -----------------------------------
# AYRICA UPDATE SERVERİ/CDN YOXDUR: buraxılış kataloqu `app_versions`
# cədvəlidir, quraşdırıcı faylın özü isə `app-updates` (PRIVATE) bucket-indədir:
#   app-updates/{versiya}/KompasOS-Setup.exe
# Bucket private olduğu üçün endirmə `anon` açarı tələb edir — public link
# işləmir. Yükləmə isə YALNIZ `service_role` ilə (Developer Paneli).
KOMPASOS_SUPABASE_URL=
KOMPASOS_SUPABASE_ANON_KEY=
KOMPASOS_UPDATE_BUCKET=app-updates
# Authenticode naşir yoxlaması — BOŞ BURAXMAYIN: bu olmadan İSTƏNİLƏN etibarlı
# imza qəbul edilir (hücumçunun öz qanuni sertifikatı da daxil).
KOMPASOS_UPDATE_PUBLISHER=O=Kompas MMC

# --- Gecəlik ehtiyat nüsxə (bax bölmə 7) ------------------------------------
# `pg_dump` PATH-də olmalıdır. Saxlama müddəti kodda minimum 30 gündür.
KOMPASOS_BACKUP_DIR=

# --- E-poçt fallback (bax bölmə 7) ------------------------------------------
KOMPASOS_SMTP_HOST=
KOMPASOS_SMTP_PORT=587
KOMPASOS_SMTP_USER=
KOMPASOS_SMTP_PASSWORD=
KOMPASOS_SMTP_FROM=noreply@example.com
# Tətbiq açılmasa belə müştərinin çata biləcəyi statik ünvan (bölmə 8)
KOMPASOS_SUPPORT_EMAIL=destek@example.com
